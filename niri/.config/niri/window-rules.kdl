// ────────────── Window Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true // Always float Firefox PiP windows
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=-130 y=-20 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id="feishin"
    open-on-workspace "media"
    open-maximized true
}

window-rule {
    match app-id="com.obsproject.Studio"
    open-on-workspace "obs"
    open-maximized true
}

window-rule {
    match app-id="vesktop"
    open-on-workspace "chat"
    open-maximized true
}

window-rule {
    match app-id="blueman-manager"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="nm-connection-editor"
    match app-id="com.mitchellh.ghostty" title="btop"
    
    open-floating true
    max-width 800
    max-height 600
    default-floating-position x=12 y=12 relative-to="top-right"
    opacity 0.95

    focus-ring {
        off
    }
}

window-rule {
    match title="pompom"
    open-floating true

    max-width 300
    max-height 300

    default-floating-position x=12 y=12 relative-to="top-left"
}

window-rule {
    match app-id="org.mixxx.Mixxx" title="Library Scanner"
    open-floating true

    max-width 580
    max-height 100
}

window-rule {
    match app-id="t3code"

    // gaps 8 // Gap between windows - Default 16
    // center-focused-column "never" // Don’t auto-center focused column

    focus-ring {
        width 1
    }

    tiled-state false

    // shadow {
    //     softness 30
    //     spread 5
    //     offset x=0 y=5
    //     color "#0007"
    // }

}
